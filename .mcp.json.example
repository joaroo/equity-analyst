{
  "_comment": "Example connector wiring: Slack (notifications). The market-data connector is unbound until a broker MCP server is added. Copy relevant sections into ~/.claude.json or .claude/settings.json. Set environment variables before running.",

  "mcpServers": {
    "slack": {
      "_connector": "notifications",
      "_docs": "connectors/slack/CONNECTOR.md",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    }
  },

  "env": {
    "NOTIFICATION_MCP_TOOL": "mcp__slack__slack_post_message",
    "SLACK_CHANNEL_ID": "${SLACK_CHANNEL_ID}"
  }
}
