{
  "_comment": "Example wiring for Claude Code. market-data (self-hosted MCP) backs quotes/history/indicators/fx; a broker MCP backs portfolio (read tools only); Slack backs notifications. The research alias is built-in WebSearch/WebFetch and needs no server. In claude.ai/Cowork, add the HTTP servers as custom connectors instead.",

  "mcpServers": {
    "market-data": {
      "_connectors": ["quotes", "history", "indicators", "fx"],
      "_docs": "connectors/market-data/CONNECTOR.md",
      "type": "http",
      "url": "https://<your-host>/<MCP_PATH_SECRET>/mcp"
    },

    "montrose": {
      "_connector": "portfolio",
      "_docs": "connectors/README.md#portfolio-provider",
      "type": "http",
      "url": "https://mcp.montrose.io/"
    },

    "slack": {
      "_connector": "notifications",
      "_docs": "connectors/slack/CONNECTOR.md",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    }
  },

  "env": {
    "NOTIFICATION_MCP_TOOL": "mcp__slack__slack_post_message",
    "SLACK_CHANNEL_ID": "${SLACK_CHANNEL_ID}"
  }
}
